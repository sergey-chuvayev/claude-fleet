{
  "name": "@sergeychuvayev/claude-fleet",
  "version": "0.54.0",
  "description": "A local control room for Claude Code sessions",
  "keywords": [
    "claude",
    "claude-code",
    "dashboard",
    "agents",
    "cli",
    "anthropic"
  ],
  "homepage": "https://github.com/sergey-chuvayev/claude-fleet#readme",
  "bugs": "https://github.com/sergey-chuvayev/claude-fleet/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergey-chuvayev/claude-fleet.git"
  },
  "license": "MIT",
  "author": "Sergey Chuvayev",
  "bin": {
    "claude-fleet": "bin/claude-fleet.js"
  },
  "files": [
    "bin/",
    "public/",
    "build/make-app.sh",
    "archive.js",
    "checkouts.js",
    "service.js",
    "history.js",
    "codex.js",
    "sync.js",
    "catalog.js",
    "connections.js",
    "day.js",
    "day-agent.js",
    "project-agent.js",
    "progress.js",
    "projects.js",
    "dispatch.js",
    "fleet.js",
    "managed.js",
    "open.js",
    "owner-review.js",
    "pr-status.js",
    "paths.js",
    "permissions.js",
    "references.js",
    "routing.js",
    "search.js",
    "server.js",
    "settings.js",
    "teams.js",
    "theme.js",
    "update.js",
    "worktree.js",
    "team-store.js",
    "tasks.js",
    "usage.js"
  ],
  "scripts": {
    "start": "node bin/claude-fleet.js start",
    "test": "node --require ./test-setup.js --test *.test.js docs/prototypes/*/*.test.js",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test:frontend": "vitest run --config frontend/vite.config.mts",
    "dev:frontend": "vite --config frontend/vite.config.mts",
    "build:frontend": "vite build --config frontend/vite.config.mts",
    "vendor": "esbuild build/vendor-entry.js --bundle --minify --format=iife --target=es2022 --outfile=public/vendor/libs.js",
    "icons": "node build/make-icons.js",
    "app": "node bin/claude-fleet.js install-app",
    "prototype": "node docs/prototypes/task-control/preview-server.js",
    "prepack": "npm run vendor"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.177",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
